# Secrets only — this file belongs on the server, never in VITE_* variables.
MONGODB_URI=mongodb+srv://USER:NEW_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=box
JWT_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (optional until configured; see DEPLOYMENT.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local default: http://localhost:8787/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Public app origin; must match the origin of GOOGLE_REDIRECT_URI (same HTTPS host/port).
APP_URL=

# Comma-separated allowed origins for the account API.
APP_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8787
# Optional. Blank uses SERVER_PORT when supplied, otherwise port 8787.
PORT=
HOST=0.0.0.0

# PeerJS signaling server capacity; browser-to-browser game data uses WebRTC.
PEER_CONCURRENT_LIMIT=2000
